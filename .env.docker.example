# Copy to .env.docker and replace the example values for the target deployment.
# This file contains configuration only; never put passwords, API secrets, or tokens here.
APP_BASE_URL=https://metafrix.example.com
DJANGO_ALLOWED_HOSTS=metafrix.example.com,backend,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://metafrix.example.com

POSTGRES_DB=metafrix
POSTGRES_USER=metafrix
SECRETS_DIR=.secrets

# Bind Next.js only to loopback; terminate TLS in a trusted reverse proxy.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Set real provider client IDs (not client secrets) to enable these options.
# Register https://metafrix.example.com/api/auth/oauth/google/callback
# and https://metafrix.example.com/api/auth/oauth/microsoft/callback.
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common

# Configure an authenticated SMTP service and a verified sender.
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=noreply@example.com
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=MetafriX <noreply@example.com>

# Keep subdomain HSTS opt-in until every affected hostname is HTTPS-only.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
