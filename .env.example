# Server-side URL used by the Next.js API proxy. Do not expose this as NEXT_PUBLIC_*.
BACKEND_API_URL=http://127.0.0.1:8001
APP_BASE_URL=http://localhost:3000

# Local-only shared secret; copy the same value to backend/.env.
# Never reuse this example value outside local development.
AUTH_EXCHANGE_SECRET=local-only-development-oauth-exchange-secret-not-for-production

# Optional OAuth credentials for local testing. Register these callback URLs:
# http://localhost:3000/api/auth/oauth/google/callback
# http://localhost:3000/api/auth/oauth/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Optional local-only UI demo with mock content; keep false/undefined in production.
NEXT_PUBLIC_DEMO_MODE=false
