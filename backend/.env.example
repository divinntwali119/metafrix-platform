# Local development only. Replace every value with managed secrets in production.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-only-change-before-deploy
APP_BASE_URL=http://localhost:3000
AUTH_EXCHANGE_SECRET=local-only-development-oauth-exchange-secret-not-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_NUM_PROXIES=0
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_CACHE_URL=

# Enable HSTS includeSubDomains/preload only after confirming every affected hostname is HTTPS-only.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# Keep media and Git repositories on persistent private volumes in deployments.
DJANGO_MEDIA_ROOT=./media
GIT_REPOSITORY_ROOT=./var/git/repos

# Production requires PostgreSQL and shared Redis, for example:
# DATABASE_URL=postgresql://USER:PASSWORD@DB-HOST:5432/afrihub
# DJANGO_CACHE_URL=redis://REDIS-HOST:6379/0
# Use rediss:// when Redis traffic crosses an untrusted network.

# Configure an authenticated SMTP provider before enabling password recovery emails.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=noreply@localhost